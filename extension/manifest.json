{
  "manifest_version": 3,
  "name": "QuickGrab Browser Integration",
  "version": "0.2.0",
  "description": "Send direct file downloads to QuickGrab on Windows. Supports incognito with browser permission.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "storage"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickGrab"
  }
}