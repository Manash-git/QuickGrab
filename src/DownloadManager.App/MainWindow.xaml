<Window x:Class="DownloadManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QuickGrab — Personal download manager" Width="1180" Height="760" MinWidth="920" MinHeight="600" Background="#F4F6FA" FontFamily="Segoe UI" FontSize="13" Closing="OnClosing">
<Grid Margin="24">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="QuickGrab" FontSize="27" FontWeight="SemiBold" Foreground="#14213B"/><TextBlock Text="Your files. One organized queue." Foreground="#657189" Margin="0,5,0,0"/></StackPanel><TextBlock Text="PERSONAL • 0.2.0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#657189"/></Grid>
<Border Grid.Row="1" Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,16">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="UrlBox" ToolTip="Paste an HTTP or HTTPS file URL" AutomationProperties.Name="Download URL" Margin="0,0,12,0" KeyDown="UrlKeyDown"/>
<Button Grid.Column="1" Content="+ Add download" Background="#2457D6" Foreground="White" Click="AddClick" Margin="0"/></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#EAF0F9" CornerRadius="8" Padding="12" Margin="0,0,16,0"><StackPanel><TextBlock Text="CATEGORIES" Foreground="#657189" FontSize="11" Margin="8,4,0,14"/>
<ListBox x:Name="Categories" BorderThickness="0" Background="Transparent" SelectionChanged="CategoryChanged" SelectedIndex="0">
<ListBoxItem Content="All downloads"/><ListBoxItem Content="Documents"/><ListBoxItem Content="Archives"/><ListBoxItem Content="Video"/><ListBoxItem Content="Audio"/><ListBoxItem Content="Programs"/><ListBoxItem Content="Other"/>
</ListBox><TextBlock Text="Direct file downloads" Margin="8,30,0,0" Foreground="#657189" TextWrapping="Wrap"/><TextBlock Text="Chrome/Edge browser capture is available. Media-page extraction is planned next." Margin="8,8,0,0" Foreground="#657189" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
<Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel Margin="0,0,0,14"><Button Content="Resume" Click="ResumeClick"/><Button Content="Pause" Click="PauseClick"/><Button Content="Restart…" Click="RestartClick"/><Button Content="Open folder" Click="FolderClick"/></WrapPanel>
<DataGrid x:Name="Downloads" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F5" BorderThickness="0" Background="White" RowHeight="40" SelectionChanged="DownloadSelected">
<DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="*" MinWidth="120"/><DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="100"/><DataGridTemplateColumn Header="Progress" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="5,0"><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" Foreground="#2457D6" Background="#EAF0FC"/><TextBlock Text="{Binding PercentText, Mode=OneWay}" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Transferred" Binding="{Binding Size, Mode=OneWay}" Width="145"/><DataGridTextColumn Header="Speed" Binding="{Binding Speed, Mode=OneWay}" Width="100"/></DataGrid.Columns></DataGrid>
<Border Grid.Row="2" Background="#F7F9FC" Padding="12" Margin="0,12,0,0"><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MinHeight="62" MaxHeight="120" VerticalScrollBarVisibility="Auto" Text="Select a download to see its destination and recovery details."/></Border>
</Grid></Border></Grid>
<Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" VerticalAlignment="Center" Foreground="#657189"/>
<StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Simultaneous" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ConcurrencyBox" Width="50" VerticalContentAlignment="Center"/><TextBlock Text="Limit (KiB/s, 0 = unlimited)" VerticalAlignment="Center" Margin="16,0,8,0"/><TextBox x:Name="LimitBox" Width="80"/><Button Content="Apply" Click="ApplyClick" Margin="8,0,0,0"/></StackPanel></Grid>
</Grid></Window>
